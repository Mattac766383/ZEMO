{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "npm run sidecar:prepare && npm run build"
  },
  "bundle": {
    "targets": ["nsis"],
    "externalBin": [
      "binaries/operation-executor"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
