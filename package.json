{
  "name": "working-name-local-first",
  "version": "0.1.0",
  "private": true,
  "description": "Application desktop local-first d'organisation sémantique de fichiers",
  "workspaces": [
    "apps/desktop"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @working-name/desktop",
    "build": "npm run build --workspace @working-name/desktop",
    "tauri": "npm run tauri --workspace @working-name/desktop --",
    "typecheck": "npm run typecheck --workspace @working-name/desktop",
    "test:ui": "npm run test --workspace @working-name/desktop",
    "test:rust": "cargo test --workspace",
    "test": "npm run typecheck && npm run test:ui",
    "windows:qualification": "node ./scripts/windows-qualification/run.mjs --json",
    "windows:qualification:prep": "node ./scripts/windows-qualification/run.mjs --prep-only --json",
    "windows:ci:download-granite": "node ./scripts/windows-ci/download-pinned-granite.mjs",
    "windows:ci:decide-apply": "node ./scripts/windows-ci/decide-apply-qualification.mjs",
    "macos:apply:qualification": "node ./scripts/macos-apply-qualification/run.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
